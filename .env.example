# Application Ports
PORT=5000

# Railway MySQL Cloud Environment
# Example: mysql://user:password@containers-us-west-XX.railway.app:5761/railway
DATABASE_URL=mysql://root:password@<RAILWAY_HOST>:<RAILWAY_PORT>/railway

# JWT Authentication
JWT_SECRET=your_super_secret_key
JWT_EXPIRES_IN=7d

# OpenAI Integration (Python AI Module)
OPENAI_API_KEY=sk-your-openai-api-key

# Embedding / RAG Models
# Specify local model paths or huggingface repo ids if overriding
SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2
